# Where the FastAPI planning API lives. Read only in Next route handlers, never in client JS.
TP_API_URL=http://127.0.0.1:8000

# Optional. A MapLibre style URL for the plan screen's basemap, swappable without a code change if
# the tile host goes away. It is a style URL and not a key, so the rule that no Google key reaches
# client JS still holds. Defaults to OpenFreeMap positron; its attribution control is the licence
# compliance, so leave it visible.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
