# Copy to .env and fill in. .env is gitignored; this file is not.

# RDS. sslmode=require; the driver must be psycopg (psycopg3), not psycopg2.
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/trip_planner?sslmode=require

# Places + Routes + YouTube Data API, one restricted key.
GOOGLE_API_KEY=
# Gemini, for transcript and note extraction.
GEMINI_API_KEY=

# Google sign-in, a separate OAuth client from the API key above. The redirect URI must be an
# Authorized redirect URI on that client and match byte-for-byte — trailing slash included — and it
# lives here alone because tp_api uses the same string to build the consent URL and to exchange the
# code. Console changes take 5 minutes to a few hours to propagate.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Swap when a model's free tier runs out. Every prompt resolves its model through this. It lands in
# extractions.model, so changing it re-extracts rather than reusing another model's result.
GEMINI_MODEL=gemini-3.5-flash-lite

# RedNote needs a cookie AND a signature, and the signature is bound to the URL path — hence one
# set per endpoint. Only the cookie expires, so rotation means editing XHS_COOKIE alone.
XHS_COOKIE=
# /api/sns/web/v1/search/notes
XHS_SEARCH_XS=
XHS_SEARCH_XT=
XHS_SEARCH_XS_COMMON=
XHS_SEARCH_XRAP=
# /api/sns/web/v1/feed
XHS_FEED_XS=
XHS_FEED_XT=
XHS_FEED_XS_COMMON=
XHS_FEED_XRAP=

# Base-image mirror for `docker compose build` behind corporate TLS interception, because dockerd
# verifies against the host trust store. Unset on EC2, where docker.io verifies normally.
DOCKER_REGISTRY=
